{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "mem",
            "args": [
              "hook",
              "session-start"
            ],
            "timeout": 10,
            "statusMessage": "기억 불러오는 중"
          },
          {
            "type": "command",
            "command": "Tools/GamedesignTool/bin/stage.exe",
            "args": [
              "show",
              "--hook"
            ],
            "timeout": 10,
            "statusMessage": "기획 단계 읽는 중"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mem",
            "args": [
              "hook",
              "subagent-start"
            ],
            "timeout": 10,
            "statusMessage": "기억 불러오는 중"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "Tools/GamedesignTool/bin/stage.exe",
            "args": [
              "lint",
              "--hook"
            ],
            "timeout": 10,
            "statusMessage": "기획 순서 검사 중"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "Tools/GamedesignTool/bin/stage.exe",
            "args": [
              "done",
              "--hook"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(mem search:*)",
      "PowerShell(mem search *)",
      "Bash(mem show:*)",
      "PowerShell(mem show *)",
      "Bash(mem add:*)",
      "PowerShell(mem add *)",
      "Bash(mem set:*)",
      "PowerShell(mem set *)",
      "Bash(mem lint:*)",
      "PowerShell(mem lint *)",
      "Bash(mem review)",
      "PowerShell(mem review)",
      "Bash(mem review --kind:*)",
      "PowerShell(mem review --kind *)",
      "Bash(mem tags:*)",
      "PowerShell(mem tags *)",
      "Bash(mem index)",
      "PowerShell(mem index)",
      "Bash(mem status:*)",
      "PowerShell(mem status *)",
      "Bash(mem eval:*)",
      "PowerShell(mem eval *)",
      "Bash(Tools/GamedesignTool/bin/stage.exe:*)",
      "PowerShell(.\\Tools\\GamedesignTool\\bin\\stage.exe *)"
    ]
  }
}
