{
  "version": 1,
  "namespace": "Mozzi.Data",
  "enums": {
    "DecorLayer": ["back", "front"]
  },
  "tables": [
    { "name": "mozzi_species", "columns": [
      { "name": "id",              "type": "string" },
      { "name": "name",            "type": "string", "loc": true },
      { "name": "family",          "type": "string", "desc": "grass · water · lava · swamp" },
      { "name": "tier",            "type": "int",    "min": 1, "max": 3 },
      { "name": "is_shiny",        "type": "bool" },
      { "name": "ingredient_id",   "type": "string", "desc": "내는 부재료 id. 안 내면 빈 문자열" },
      { "name": "next_species_id", "type": "string", "desc": "다음 단계 종 id. 3단계면 빈 문자열" },
      { "name": "color_hex",       "type": "string" },
      { "name": "sprite_key",      "type": "string", "desc": "Art/ 뒤에 붙는 그림 자리" },
      { "name": "accessory_id",    "type": "string", "desc": "머리 장식 그림 이름 (acc_<id>). none 이면 빈 그림" } ] },
    { "name": "ingredient", "columns": [
      { "name": "id",         "type": "string" },
      { "name": "name",       "type": "string", "loc": true },
      { "name": "tier",       "type": "int",    "min": 1 },
      { "name": "value",      "type": "int",    "min": 0 },
      { "name": "cap",        "type": "int",    "min": 0, "desc": "창고(주운 것) 기준 상한" },
      { "name": "color_hex",  "type": "string" },
      { "name": "sprite_key", "type": "string", "desc": "Art/ 뒤에 붙는 그림 자리. 비면 color_hex 네모" } ] },
    { "name": "recipe", "columns": [
      { "name": "id",                   "type": "string" },
      { "name": "name",                 "type": "string", "loc": true },
      { "name": "ingredient_ids",       "type": "list<ref>", "ref": "ingredient" },
      { "name": "reveal_ingredient_id", "type": "string", "desc": "3재료 힌트로 미리 보여 줄 재료 id. 없으면 빈 문자열" },
      { "name": "sprite_key",           "type": "string", "desc": "Art/ 뒤에 붙는 그림 자리. 비면 글자만" } ] },
    { "name": "synthesis_rule", "columns": [
      { "name": "id",                  "type": "string" },
      { "name": "tier",                "type": "int",   "min": 1, "max": 3 },
      { "name": "gold",                "type": "int",   "min": 0 },
      { "name": "wait_sec",            "type": "int",   "min": 0 },
      { "name": "p_fixed",             "type": "float", "min": 0, "max": 1 },
      { "name": "p_other_family",      "type": "float", "min": 0, "max": 1 },
      { "name": "p_shiny",             "type": "float", "min": 0, "max": 1 },
      { "name": "p_other_family_top",  "type": "float", "min": 0, "max": 1, "desc": "3단계 2마리(다음 단계 없음)일 때 확률" },
      { "name": "p_shiny_top",         "type": "float", "min": 0, "max": 1, "desc": "3단계 2마리(다음 단계 없음)일 때 확률" } ] },
    { "name": "growth", "columns": [
      { "name": "id",    "type": "string" },
      { "name": "kind",  "type": "string", "desc": "slot · shortcut · pair · fence" },
      { "name": "level", "type": "int",    "min": 1 },
      { "name": "price", "type": "int",    "min": 0 },
      { "name": "rate",  "type": "float",  "desc": "shortcut 은 대기 배율, fence 는 담장에 더해지는 마리 수(누적). slot · pair 는 안 쓴다" } ] },
    { "name": "stall", "columns": [
      { "name": "id",                "type": "string", "desc": "설정 한 줄짜리 표다. id 는 default 하나" },
      { "name": "customers_per_day", "type": "int",   "min": 0 },
      { "name": "customer_gap_sec",  "type": "float", "min": 0 },
      { "name": "queue_max",         "type": "int",   "min": 0 },
      { "name": "shelf_max",         "type": "int",   "min": 0 },
      { "name": "hint_every",        "type": "int",   "min": 0 },
      { "name": "order_mult",        "type": "float", "min": 0 },
      { "name": "plain_rate",        "type": "float", "min": 0 },
      { "name": "count_mult1",       "type": "float", "min": 0 },
      { "name": "count_mult2",       "type": "float", "min": 0 },
      { "name": "count_mult3",       "type": "float", "min": 0 },
      { "name": "clerk_price",       "type": "int",   "min": 0 },
      { "name": "clerk_speed_sec",   "type": "float", "min": 0 },
      { "name": "pound_taps",        "type": "int",   "min": 0 },
      { "name": "pound_gap_ms",      "type": "int",   "min": 0 },
      { "name": "double_tap_ms",     "type": "int",   "min": 0 } ] },
    { "name": "farm", "columns": [
      { "name": "id",                 "type": "string", "desc": "설정 한 줄짜리 표다. id 는 default 하나" },
      { "name": "fence_max",          "type": "int",   "min": 0 },
      { "name": "produce_period_sec", "type": "float", "min": 0 },
      { "name": "tier_mult1",         "type": "float", "min": 0 },
      { "name": "tier_mult2",         "type": "float", "min": 0 },
      { "name": "tier_mult3",         "type": "float", "min": 0 },
      { "name": "breed_period_sec",   "type": "float", "min": 0 },
      { "name": "storage_sell_price", "type": "int",   "min": 0 },
      { "name": "storage_max",        "type": "int",   "min": 0, "desc": "0 은 상한 없음" },
      { "name": "start_species_id",   "type": "ref",   "ref": "mozzi_species" },
      { "name": "start_count",        "type": "int",   "min": 0 } ] },
    { "name": "farm_decor", "columns": [
      { "name": "id",         "type": "string" },
      { "name": "sprite_key", "type": "string", "desc": "Art/ 뒤에 붙는 그림 자리 (Farm/decor_00 ~ 10)" },
      { "name": "col",        "type": "int",    "min": 0, "desc": "울타리 안 32 칸 가로 번호. 0 = 왼쪽" },
      { "name": "row",        "type": "int",    "min": 0, "desc": "울타리 안 32 칸 세로 번호. 0 = 아래" },
      { "name": "flip_x",     "type": "bool",   "default": false },
      { "name": "layer",      "type": "enum",   "enum": "DecorLayer", "default": "back", "desc": "back 은 찹쌀이 발밑, front 는 찹쌀이와 y 로 앞뒤를 가린다" } ] }
  ]
}
